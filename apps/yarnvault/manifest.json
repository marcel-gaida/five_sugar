{
  "manifest_version": 3,
  "name": "Yarn Vault",
  "version": "1.0.2",
  "description": "Organize your local crochet pattern PDFs and images with tags, ratings, bookmarks, and thumbnail previews.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open Yarn Vault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
