{
  "manifest_version": 3,
  "name": "Kitchen Vault",
  "version": "1.1.0",
  "description": "Organize your local cooking recipe PDFs and images with tags, ratings, bookmarks, and thumbnail previews.",
  "permissions": [
    "storage",
    "sidePanel",
    "power",
    "contextMenus",
    "scripting",
    "activeTab",
    "nativeMessaging"
  ],
  "key": "",
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "Open Kitchen Vault",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
